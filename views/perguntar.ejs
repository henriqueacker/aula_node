<div class="card mt-5">
    <div class="card-header">
        <h3>Realizar pergunta</h3>
    </div>
    <div class="card-body">
        <form method="POST" action="/salvarPergunta">
            <label>Titulo</label>
            <input type="text" class="form-control" placeholder="Titulo" name="titulo"/>

            <label class="mt-1 mb-1">Descrição</label>
            <textarea placeholder="Descrevar sua pergunta" class="form-control" name="descricao"> </textarea>

            <button class="btn btn-primary mt-3" >Perguntar</button>
        </form>
    </div>
</div>