<div class="container pt-2">
    <div class="card-header p-5">
        <h1>Perguntas</h1>
        <hr/>
        <a href="/perguntar" class="btn btn-primary">Perguntar</a>
    </div>
    <% perguntas.forEach(item => { %>
        <div class="card m-1">
            <div class="card-body">
                <h3>
                    <%= item.titulo %>
                </h3>
            </div>
            <div class="card-footer">
                <a class="btn btn-primary" href="/pergunta/<%= item.id %>">Responder</a>
            </div>


        </div>
        <% }); %>

</div>